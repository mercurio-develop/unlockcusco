generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Business {
  id           String   @id @default(uuid())
  slug         String   @unique @default(uuid())
  name         String
  category     String
  lat          Float
  lng          Float
  rating       Float?
  reviewsCount Int      @default(0)
  imageUrl     String
  whatsapp     String?
  isClaimed    Boolean  @default(false)
  locationSlug String   @default("")
  categorySlug String   @default("")
  reviews      Review[]
}

model Review {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  text       String
  author     String
  rating     Int
}