generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Business {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  category String @default("DINING")

  // Shared fields
  lat          Float?
  lng          Float?
  rating       Float?
  reviewsCount Int     @default(0)
  imageUrl     String  @default("")
  heroImages   String  @default("[]")
  whatsapp     String?
  isClaimed    Boolean @default(false)
  isAsociado   Boolean @default(false)
  isFeatured   Boolean @default(false)
  locationSlug String  @default("")

  // Extended Profile Fields
  tagline            String  @default("")
  description        String  @default("")
  contactEmail       String  @default("")
  socialLinks        String  @default("{}")
  instagramHandle    String?
  instagramFollowers Int     @default(0)

  // Pricing & Metrics
  priceTier              String @default("$$")
  marginTier             String @default("STANDARD")
  commissionRate         Float  @default(0.05)
  viewsCount             Int    @default(0)
  whatsappClicksCount    Int    @default(0)
  aiRecommendationsCount Int    @default(0)

  // Transport Specific
  vehicleType  String?
  capacity     Int?
  serviceZones String  @default("[]")

  // Agency Specific
  guideName    String?
  seoMetaTitle String?
  seoMetaDesc  String?

  // Domain Specific JSONs 
  specialties  String @default("[]")
  themeConfig  String @default("{}")
  featuresJson String @default("[]")

  // Relations
  leads        Lead[]
  reviews      Review[]
  services     BusinessService[]
  tourPackages TourPackage[]
  trips        Trip[]
}

model BusinessService {
  id           String   @id @default(cuid())
  businessId   String
  title        String
  description  String
  priceUsd     Float
  durationMins Int      @default(60)
  imageUrl     String?
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String   @id @default(uuid())
  businessId   String
  touristName  String
  touristEmail String
  touristPhone String?
  date         DateTime
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  businessId String
  text       String
  author     String
  rating     Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TourPackage {
  id            String    @id @default(cuid())
  businessId    String?
  title         String
  tagline       String    @default("")
  sector        String
  pace          String    @default("BALANCED")
  description   String
  basePriceUsd  Float
  difficulty    String    @default("MODERATE")
  maxAltitude   String    @default("")
  durationDays  Int       @default(1)
  durationStr   String    @default("")
  elevation     String    @default("")
  bestSeason    String    @default("")
  packageType   String    @default("SINGLE_DAY")
  tags          String    @default("")
  included      String    @default("[]")
  notIncluded   String    @default("[]")
  highlights    String    @default("[]")
  requirements  String    @default("[]")
  itineraryJson String    @default("[]")
  galleryJson   String    @default("[]")
  heroImage     String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tripDays      TripDay[]
}

enum TravelerArchetype {
  LIVING_CULTURE
  GASTRONOMIC
  LUXURY_WELLNESS
  SPIRITUAL
  MOUNTAIN_EXPLORER
}

model Trip {
  id                 String             @id @default(cuid())
  userId             String?
  businessId         String?
  tripTitle          String
  startDate          DateTime
  endDate            DateTime
  paxCount           Int                @default(1)
  baseCampStrategy   String
  archetype          TravelerArchetype?
  intensity          Int?
  shareToken         String?            @unique
  status             String             @default("DRAFT")
  totalPriceUsd      Float              @default(0)
  createdAt          DateTime   @default(now())
  isVerifiedTemplate Boolean    @default(false)
  templateVibeTags   String?
  clonedFromId       String?
  travelers          Traveler[]
  business           Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  days               TripDay[]
}

model Traveler {
  id                  String   @id @default(cuid())
  tripId              String
  isLeadGuest         Boolean  @default(false)
  firstName           String
  lastName            String
  passportNumber      String
  nationality         String
  dateOfBirth         DateTime
  whatsappNumber      String?
  dietaryRestrictions String?
  medicalNotes        String?
  createdAt           DateTime @default(now())
  trip                Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripDay {
  id             String       @id @default(cuid())
  tripId         String
  dayNumber      Int
  date           DateTime
  sleepTown      String
  tourPackageId  String?
  dayTheme       String
  guideNotes     String?
  startTime      String       @default("08:00 AM")
  meetingPoint   String?
  eventsJson     String       @default("[]")
  isAgencyLocked Boolean      @default(true)
  isCustomized   Boolean      @default(false)
  tourPackage    TourPackage? @relation(fields: [tourPackageId], references: [id])
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
