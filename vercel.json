{
  "buildCommand": "next build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-itineraries",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/heal-images",
      "schedule": "0 3 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
